<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Version>4.11.0</Version>
    <Company>sgtlaggy</Company>
    <Copyright>Copyright © sgtlaggy 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <DistDir>dist</DistDir>
    <DirToZip>$(DistDir)\zip</DirToZip>
    <ModDir>$(DirToZip)\SPT_Runtime\user\mods\$(MSBuildProjectName)</ModDir>
  </PropertyGroup>

  <Target Name="BuildDist" AfterTargets="AfterBuild">
    <ItemGroup>
      <OutputDLL Include="$(TargetPath)"/>
      <Resources Include="Resources\**\*.*"/>
    </ItemGroup>

    <RemoveDir Directories="$(DistDir)"/>
    <Copy
        SourceFiles="@(OutputDLL);@(Resources)"
        DestinationFolder="$(ModDir)\%(RecursiveDir)"/>
    <!-- Korean README of this fork (Resources/README.md is the original author's) -->
    <Copy
        SourceFiles="README.md"
        DestinationFiles="$(ModDir)\README_KR.md"/>
  </Target>
  <!-- F12 live-settings client plugin: built automatically when the game files are found -->
  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
  </PropertyGroup>
  <Target Name="BuildClientPlugin" BeforeTargets="BuildDist" Condition="Exists('$(SptRoot)\BepInEx\core\BepInEx.dll')">
    <MSBuild Projects="client\QuestTweaksLive.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);SptRoot=$(SptRoot);_RestoreRun=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="client\QuestTweaksLive.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);SptRoot=$(SptRoot)" />
  </Target>
  <Target Name="WarnNoClientPlugin" BeforeTargets="BuildDist" Condition="!Exists('$(SptRoot)\BepInEx\core\BepInEx.dll')">
    <Warning Text="F12 plugin (QuestTweaksLive.dll) not built: game files not found at '$(SptRoot)'. Build with -p:SptRoot=&quot;your SPT folder&quot;." />
  </Target>
  <Target Name="CopyClientPlugin" AfterTargets="BuildDist" Condition="Exists('client\bin\$(Configuration)\QuestTweaksLive.dll')">
    <Copy
        SourceFiles="client\bin\$(Configuration)\QuestTweaksLive.dll"
        DestinationFolder="$(DirToZip)\BepInEx\plugins"/>
  </Target>
  <Target Name="CopyPDB" AfterTargets="BuildDist" Condition="'$(Configuration)' == 'Debug'">
    <Copy
        SourceFiles="$(TargetDir)$(TargetName).pdb"
        DestinationFolder="$(ModDir)"/>
  </Target>
  <Target Name="Zip" AfterTargets="CopyClientPlugin" Condition="'$(Configuration)' == 'Release'">
    <ZipDirectory
        SourceDirectory="$(DirToZip)"
        DestinationFile="$(DistDir)\$(MSBuildProjectName)-$(Version).zip"/>
  </Target>

  <ItemGroup>
    <!-- client/ is the separate BepInEx plugin project (F12 live settings) -->
    <Compile Remove="client/**" />
    <None Remove="client/**" />
    <Content Remove="client/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
    <PackageReference Include="SPTushonka.Server.Web" Version="4.1.6" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" />
  </ItemGroup>

</Project>
